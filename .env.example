# Copy to `.env` and fill in real values. Never commit `.env`.
# Vite only exposes variables prefixed with VITE_.

# Required — Supabase (hosted project or local `supabase start`)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional — Google Gemini AI assistant
# Production: store the key in Supabase → Project Settings → Edge Functions → Secrets
# as GEMINI_API_KEY (or VITE_GEMINI_API_KEY). The app calls the gemini-chat edge function.
# Local-only fallback (optional): uncomment and set if you run without deploying the function.
# VITE_GEMINI_API_KEY=

# Optional — Twilio (client-visible phone display only; secrets stay in edge functions)
VITE_TWILIO_PHONE_NUMBER=

# Edge Function secrets live in Supabase → Project Settings → Edge Functions → Secrets.
# Do not put these in Vite env or commit them.
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
#   TWILIO_AUTH_TOKEN is required for webhook signatures. If the edge secret is
#   truncated, the function falls back to Vault RPC get_twilio_edge_secrets.
# Optional TWILIO_WEBHOOK_URL — set this when the function sees an internal host
# instead of the public URL Twilio signed. Use the public origin
# (https://YOUR_PROJECT_REF.supabase.co) or the exact console webhook.
# Scheme, host, and path must match the Twilio console value, with no extra slash.
# Voice callbacks keep that host and append ?step=...
# TWILIO_WEBHOOK_URL=https://YOUR_PROJECT_REF.supabase.co
