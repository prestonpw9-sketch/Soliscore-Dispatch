# dependencies
node_modules

# local env / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.p12

# Vite build output (repo root only; the local Capacitor plugin commits its JS entry)
/dist

# playwright
/test-results/
/playwright-report/
/blob-report/

# logs & OS junk
*.log
.DS_Store
Thumbs.db

# editor / local tooling
.vscode/
.idea/
*.swp
*.swo

# supabase CLI local state
supabase/.temp/

# Capacitor native build output
android/.gradle/
android/**/build/
android/local.properties
android/captures/
android/app/src/main/assets/public
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/App/App/public
*.xcuserstate

# tsc now runs with noEmit; no compiled JS should land in src.
# (If you ever add a real .js source file, force-add it: git add -f path.js)
src/**/*.js
src/**/*.js.map
